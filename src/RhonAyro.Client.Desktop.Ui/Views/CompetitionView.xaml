<UserControl x:Class="RhonAyro.Client.Desktop.Ui.Views.CompetitionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RhonAyro.Client.Desktop.Ui.Views"
             xmlns:vm="clr-namespace:RhonAyro.Client.Desktop.Ui.ViewModels"
             xmlns:behaviors="clr-namespace:RhonAyro.Client.Desktop.Ui.Behaviors"
             xmlns:converters="clr-namespace:RhonAyro.Client.Desktop.Ui.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <UserControl.Resources>
        <converters:NotConverter x:Key="Inverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="12*"/>
        </Grid.RowDefinitions>

        <!-- Choose discipline -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 3 0 5">

            <!-- Dropdown with the same items as before -->
            <ComboBox ItemsSource="{Binding DisciplineItems}"
                      SelectedItem="{Binding SelectedDiscipline, Mode=TwoWay}"
                      DisplayMemberPath="Name"
                      Padding="16 6"
                      VerticalContentAlignment="Center"
                      IsEnabled="{Binding IsSessionLocked, Converter={StaticResource Inverter}, Mode=OneWay}"
                      ToolTip="Choose a discipline and confirm to start the session."/>

            <!-- Confirm starts & locks the session -->
            <Button Content="{Binding SessionControlButtonText, Mode=OneWay}"
                    Margin="12 0 0 0"
                    Padding="16 6"
                    FontSize="16"
                    FontWeight="Bold"
                    Command="{Binding StartSessionCommand}"
                    IsDefault="True" />

            <!-- Optional: visible only while locked to allow manual ending during dev/tests -->
            <!--<Button Content="Unlock (Dev)"
            Margin="8,0,0,0"
            Command="{Binding UnlockSessionCommand}" />-->
        </StackPanel>

        <!-- Competition view -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/> <!-- Start list -->
                <ColumnDefinition Width="3*"/> <!-- Scoring -->
            </Grid.ColumnDefinitions>

            <!-- Start list -->
            <DataGrid ItemsSource="{Binding Roster}"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False">
                <DataGrid.Columns>
                    <!-- Athlete -->
                    <DataGridTextColumn
                                Binding="{Binding Athlete, Mode=OneWay}"
                                IsReadOnly="True">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="Athlete"/>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="5 0 5 0"/>
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                <Setter Property="FontSize" Value="14"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Wheel -->
                    <DataGridTextColumn
                                Binding="{Binding WheelSize, Mode=OneWay}"
                                IsReadOnly="True">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="Wheel size"/>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="5 0 5 0"/>
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Coach -->
                    <DataGridTextColumn
                                Binding="{Binding Coach, Mode=OneWay}"
                                IsReadOnly="True">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="Coach"/>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="5 0 5 0"/>
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Scoring -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="4*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>

                <!-- Current contestant -->
                <Rectangle Grid.RowSpan="5"
                           Fill="Transparent"
                           Stroke="Black"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Rectangle Grid.RowSpan="2"
                               Fill="Transparent"
                               Stroke="Black"/>
                    <Label Grid.RowSpan="2"
                           Content="{Binding StartNumber}"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center"
                           FontSize="30"
                           FontWeight="Bold"/>

                    <Rectangle Grid.Column="1" Grid.RowSpan="2"
                               Fill="Transparent"
                               Stroke="Black"/>
                    <Label Grid.Column="1"
                           Content="Athlete"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center"/>
                    <Label Grid.Column="1" Grid.Row="1"
                           Content="{Binding Athlete}"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center"
                           FontSize="17"
                           FontWeight="Bold"
                           Margin="0 0 0 7"/>

                    <Rectangle Grid.Column="2" Grid.RowSpan="2"
                               Fill="Transparent"
                               Stroke="Black"/>
                    <Label Grid.Column="2"
                           Content="Coach"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center"/>
                    <Label Grid.Column="2" Grid.Row="1"
                           Content="{Binding Coach}"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center"
                           FontSize="17"
                           Margin="0 0 0 7"/>

                    <Rectangle Grid.Column="3" Grid.RowSpan="2"
                               Fill="Transparent"
                               Stroke="Black"/>
                    <Label Grid.Column="3"
                           Content="Wheel size"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center"/>
                    <Label Grid.Column="3" Grid.Row="1"
                           Content="{Binding WheelSize}"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center"
                           FontSize="17"
                           Margin="0 0 0 7"/>
                </Grid>
                
                <!-- Score recording-->
                <Grid Grid.Row="2">
                    <Grid.Resources>
                        <Style TargetType="TextBox">
                            <Setter Property="Margin" Value="0 5 100 5"/>
                            <Setter Property="FontSize" Value="20"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="1*"/>
                        </Style>
                    </Grid.Resources>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Difficulty"
                                   HorizontalContentAlignment="Right"
                                   VerticalContentAlignment="Center"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Margin="5"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding Difficulty}"
                                     behaviors:TextBoxBehaviors.NumericInput="True"
                                     behaviors:TextBoxBehaviors.AllowDecimal="True"
                                     behaviors:TextBoxBehaviors.AllowNegative="False"
                                     behaviors:TextBoxBehaviors.MaxDecimalPlaces="2"
                                     IsEnabled="{Binding IsSessionLocked, Mode=OneWay}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Juror 1"
                                   HorizontalContentAlignment="Right"
                                   VerticalContentAlignment="Center"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Margin="5"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding ScoreOne}"
                                     behaviors:TextBoxBehaviors.NumericInput="True"
                                     behaviors:TextBoxBehaviors.AllowDecimal="True"
                                     behaviors:TextBoxBehaviors.AllowNegative="False"
                                     behaviors:TextBoxBehaviors.MaxDecimalPlaces="2"
                                     IsEnabled="{Binding IsSessionLocked, Mode=OneWay}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Juror 2"
                                   HorizontalContentAlignment="Right"
                                   VerticalContentAlignment="Center"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Margin="5"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding ScoreTwo}"
                                     behaviors:TextBoxBehaviors.NumericInput="True"
                                     behaviors:TextBoxBehaviors.AllowDecimal="True"
                                     behaviors:TextBoxBehaviors.AllowNegative="False"
                                     behaviors:TextBoxBehaviors.MaxDecimalPlaces="2"
                                     IsEnabled="{Binding IsSessionLocked, Mode=OneWay}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Juror 3"
                                   HorizontalContentAlignment="Right"
                                   VerticalContentAlignment="Center"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Margin="5"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding ScoreThree}"
                                     behaviors:TextBoxBehaviors.NumericInput="True"
                                     behaviors:TextBoxBehaviors.AllowDecimal="True"
                                     behaviors:TextBoxBehaviors.AllowNegative="False"
                                     behaviors:TextBoxBehaviors.MaxDecimalPlaces="2"
                                     IsEnabled="{Binding IsSessionLocked, Mode=OneWay}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Juror 4"
                                   HorizontalContentAlignment="Right"
                                   VerticalContentAlignment="Center"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Margin="5"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding ScoreFour}"
                                     behaviors:TextBoxBehaviors.NumericInput="True"
                                     behaviors:TextBoxBehaviors.AllowDecimal="True"
                                     behaviors:TextBoxBehaviors.AllowNegative="False"
                                     behaviors:TextBoxBehaviors.MaxDecimalPlaces="2"
                                     IsEnabled="{Binding IsSessionLocked, Mode=OneWay}"/>
                        </Grid>
                    </StackPanel>
                </Grid>
                
                <!-- Result -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8*"/>
                        <ColumnDefinition Width="10*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Result score"
                           HorizontalContentAlignment="Right"
                           VerticalContentAlignment="Center"
                           Margin="0 0 20 0"/>
                    <Label Grid.Column="1"
                           Content="{Binding FinalScore}"
                           HorizontalContentAlignment="Left"
                           VerticalContentAlignment="Center"
                           FontSize="40"
                           FontWeight="Bold"
                           Foreground="Red"
                           Margin="20 0 0 0"/>
                </Grid>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10*"/>
                        <ColumnDefinition Width="20*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1"
                            Content="Next"
                            Command="{Binding NextPerformanceCommand}"
                            Margin="10"/>
                    <Button Content="Prev."
                            Command="{Binding PreviousPerformanceCommand}"
                            Margin="40"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
