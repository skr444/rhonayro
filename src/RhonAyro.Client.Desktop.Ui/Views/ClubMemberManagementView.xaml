<UserControl x:Class="RhonAyro.Client.Desktop.Ui.Views.ClubMemberManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RhonAyro.Client.Desktop.Ui.Views"
             xmlns:behaviors="clr-namespace:RhonAyro.Client.Desktop.Ui.Behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="17*"/>
            <ColumnDefinition Width="10*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Member editor -->
        <DataGrid ItemsSource="{Binding Members}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="True"
                  CanUserDeleteRows="False"
                  IsReadOnly="False"
                  behaviors:DataGridBehaviors.RowEditEndingCommand="{Binding SaveRowCommand}">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                            IsReadOnly="False">
                    <DataGridTextColumn.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="First name"/>
                        </DataTemplate>
                    </DataGridTextColumn.HeaderTemplate>
                </DataGridTextColumn>

                <DataGridTextColumn Binding="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"
                            IsReadOnly="False">
                    <DataGridTextColumn.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="Last name"/>
                        </DataTemplate>
                    </DataGridTextColumn.HeaderTemplate>
                </DataGridTextColumn>

                <!-- Roles as text for now; replace with a ComboBox column later -->
                <DataGridTextColumn Binding="{Binding Roles}" IsReadOnly="False">
                    <DataGridTextColumn.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="Roles"/>
                        </DataTemplate>
                    </DataGridTextColumn.HeaderTemplate>
                </DataGridTextColumn>

                <!-- Delete button column -->
                <DataGridTemplateColumn Width="Auto">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text=""/>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Delete"
                            Padding="8,2"
                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Data import -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <Rectangle Grid.RowSpan="4"
                       Fill="Transparent"
                       Stroke="Black"/>
            <Label Content="Data import"
                   VerticalContentAlignment="Center"
                   HorizontalContentAlignment="Center"
                   Margin="0"
                   FontSize="20"/>
            <Button Grid.Row="1"
                    Margin="10"
                    Content="Open file..."/>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="7*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Selected file:"
                       VerticalContentAlignment="Center"
                       HorizontalContentAlignment="Center"/>
                <Label Grid.Column="1"
                       Content="C:\somefolder\notherone\hell\data.csv"
                       VerticalContentAlignment="Center"
                       HorizontalContentAlignment="Center"
                       FontSize="11"
                       FontFamily="Consolas"
                       FontWeight="DemiBold"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
