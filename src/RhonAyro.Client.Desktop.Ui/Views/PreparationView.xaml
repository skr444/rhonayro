<UserControl x:Class="RhonAyro.Client.Desktop.Ui.Views.PreparationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RhonAyro.Client.Desktop.Ui.Views"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="7"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="8*"/>
            <ColumnDefinition Width="7"/>
            <ColumnDefinition Width="10*"/>
        </Grid.ColumnDefinitions>

        <!-- Event date -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>
            
            <Rectangle Grid.RowSpan="4"
                       Fill="Transparent"
                       Stroke="Black"/>
            <Label Content="Set the competition date and start time"
                   VerticalContentAlignment="Center"
                   HorizontalContentAlignment="Center"
                   Margin="0"
                   FontSize="20"/>
            <DatePicker Grid.Row="1"
                        Margin="10"
                        FontSize="15"
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Center"/>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="7*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Selected Date and Time:"
                       VerticalContentAlignment="Center"
                       HorizontalContentAlignment="Center"/>
                <Label Grid.Column="1"
                       Content="some date time"
                       VerticalContentAlignment="Center"
                       HorizontalContentAlignment="Center"
                       FontSize="18"
                       FontWeight="Bold"/>
            </Grid>
        </Grid>

        <!-- Data import -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>
            
            <Rectangle Grid.RowSpan="4"
                       Fill="Transparent"
                       Stroke="Black"/>
            <Label Content="Data import"
                   VerticalContentAlignment="Center"
                   HorizontalContentAlignment="Center"
                   Margin="0"
                   FontSize="20"/>
            <Button Grid.Row="1"
                    Margin="10"
                    Content="Open file..."/>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="7*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Selected file:"
                       VerticalContentAlignment="Center"
                       HorizontalContentAlignment="Center"/>
                <Label Grid.Column="1"
                       Content="C:\somefolder\notherone\hell\data.csv"
                       VerticalContentAlignment="Center"
                       HorizontalContentAlignment="Center"
                       FontSize="11"
                       FontFamily="Consolas"
                       FontWeight="DemiBold"/>
            </Grid>
        </Grid>

        <!-- Host logo -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <Rectangle Grid.RowSpan="4"
                       Fill="Transparent"
                       Stroke="Black"/>
            <Label Content="Host logo"
                   VerticalContentAlignment="Center"
                   HorizontalContentAlignment="Center"
                   Margin="0"
                   FontSize="20"/>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="7*"/>
                </Grid.ColumnDefinitions>
                <Button Margin="10"
                        Content="Open file..."/>
                <Label Grid.Column="1"
                       Content="C:\somefolder\notherone\hell\data.csv"
                       VerticalContentAlignment="Center"
                       HorizontalContentAlignment="Center"
                       FontSize="11"
                       FontFamily="Consolas"
                       FontWeight="DemiBold"/>
            </Grid>
            <Image Grid.Row="2" Grid.RowSpan="2"/>
        </Grid>

        <!-- Sponsor logo -->
        <Grid Grid.Column="2" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <Rectangle Grid.RowSpan="4"
                       Fill="Transparent"
                       Stroke="Black"/>
            <Label Content="Sponsor logos"
                   VerticalContentAlignment="Center"
                   HorizontalContentAlignment="Center"
                   Margin="0"
                   FontSize="20"/>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="7*"/>
                </Grid.ColumnDefinitions>
                <Button Margin="10"
                        Content="Open file..."/>
                <Label Grid.Column="1"
                       Content="C:\somefolder\notherone\hell\data.csv"
                       VerticalContentAlignment="Center"
                       HorizontalContentAlignment="Center"
                       FontSize="11"
                       FontFamily="Consolas"
                       FontWeight="DemiBold"/>
            </Grid>
            <Grid Grid.Row="2" Grid.RowSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="10*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Button Content="prev."
                        Margin="0 10 0 10"/>
                <Image Grid.Column="1"/>
                <Button Grid.Column="2"
                        Content="next"
                        Margin="0 10 0 10"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
