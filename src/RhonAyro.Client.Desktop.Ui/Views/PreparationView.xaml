<UserControl x:Class="RhonAyro.Client.Desktop.Ui.Views.PreparationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RhonAyro.Client.Desktop.Ui.Views"
             xmlns:converters="clr-namespace:RhonAyro.Client.Desktop.Ui.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <UserControl.Resources>
        <converters:BytesToImageSourceConverter x:Key="BytesToImage"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="7"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Width="7"/>
            <ColumnDefinition Width="11*"/>
        </Grid.ColumnDefinitions>

        <!-- Event -->
        <Grid Grid.RowSpan="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="80"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="10*"/>
            </Grid.RowDefinitions>
            
            <Rectangle Grid.RowSpan="7"
                       Fill="Transparent"
                       Stroke="Black"/>
            <Label Content="Wheel gymnastics competition"
                   VerticalContentAlignment="Center"
                   HorizontalContentAlignment="Center"
                   Margin="0"
                   FontSize="20"/>
            <Grid Grid.Row="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <DatePicker Margin="5"
                                FontSize="15"
                                VerticalContentAlignment="Center"
                                HorizontalContentAlignment="Center"
                                SelectedDate="{Binding StartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <ComboBox Margin="5"
                              Width="60"
                              VerticalContentAlignment="Center"
                              HorizontalContentAlignment="Center"
                              ItemsSource="{Binding Hours}"
                              SelectedItem="{Binding StartHour, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text=":" Margin="4 0" VerticalAlignment="Center"/>
                    <ComboBox Margin="5"
                              Width="60"
                              VerticalContentAlignment="Center"
                              HorizontalContentAlignment="Center"
                              ItemsSource="{Binding Minutes}"
                              SelectedItem="{Binding StartMinute, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="2"
                        Margin="0 0 0 10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="10*"/>
                    </Grid.ColumnDefinitions>

                    <Label Content="Competition id"/>
                    <Label Grid.Column="1"
                           Content="{Binding ActiveCompetitionId}"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="10*"/>
                    </Grid.ColumnDefinitions>

                    <Label Content="Competition date"/>
                    <Label Grid.Column="1"
                           Content="{Binding EventStart}"/>
                </Grid>
            </StackPanel>
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Button Content="New event"
                        Margin="6 0"
                        Command="{Binding NewEventCommand}"/>
                <Button Grid.Column="1"
                        Content="Delete event"
                        Margin="6 0"
                        Command="{Binding DeleteCompetitionCommand}"/>
            </Grid>
            <DataGrid Grid.Row="6"
                      ItemsSource="{Binding Competitions}"
                      SelectedItem="{Binding SelectedCompetition, Mode=OneWayToSource}"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False">
                <DataGrid.Columns>
                    <!-- Event start -->
                    <DataGridTextColumn
                        Binding="{Binding EventStart, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                        IsReadOnly="True">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="Event start"/>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="5 0 5 0"/>
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Discipline sessions -->
                    <DataGridTextColumn
                        Binding="{Binding DisciplineSessions, Mode=OneWay}"
                        IsReadOnly="True">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="Sessions"/>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="5 0 5 0"/>
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Id -->
                    <DataGridTextColumn
                        Binding="{Binding Id, Mode=OneWay}"
                        IsReadOnly="True">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="ID"/>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="5 0 5 0"/>
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                <Setter Property="FontFamily" Value="Consolas"/>
                                <Setter Property="FontSize" Value="12"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Host logo -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <Rectangle Grid.RowSpan="4"
                       Fill="Transparent"
                       Stroke="Black"/>
            <Label Content="Host logo"
                   VerticalContentAlignment="Center"
                   HorizontalContentAlignment="Center"
                   Margin="0"
                   FontSize="20"/>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="7*"/>
                </Grid.ColumnDefinitions>
                <Button Margin="10"
                        Content="Open file..."
                        Command="{Binding ImportHostLogoCommand}"/>
                <Label Grid.Column="1"
                       Content="{Binding HostLogoPath}"
                       VerticalContentAlignment="Center"
                       HorizontalContentAlignment="Center"
                       FontSize="11"
                       FontFamily="Consolas"
                       FontWeight="DemiBold"/>
            </Grid>
            <Image Grid.Row="2" Grid.RowSpan="2"
                   Source="{Binding HostLogoImage, Converter={StaticResource BytesToImage}, Mode=OneWay}"
                   Stretch="Uniform"
                   SnapsToDevicePixels="True"
                   UseLayoutRounding="True"/>
        </Grid>

        <!-- Sponsor logo -->
        <Grid Grid.Column="2" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <Rectangle Grid.RowSpan="4"
                       Fill="Transparent"
                       Stroke="Black"/>
            <Label Content="Sponsor logos"
                   VerticalContentAlignment="Center"
                   HorizontalContentAlignment="Center"
                   Margin="0"
                   FontSize="20"/>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="7*"/>
                </Grid.ColumnDefinitions>
                <Button Margin="10"
                        Content="Open file..."/>
                <Label Grid.Column="1"
                       Content="C:\somefolder\notherone\hell\data.csv"
                       VerticalContentAlignment="Center"
                       HorizontalContentAlignment="Center"
                       FontSize="11"
                       FontFamily="Consolas"
                       FontWeight="DemiBold"/>
            </Grid>
            <Grid Grid.Row="2" Grid.RowSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="10*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Button Content="prev."
                        Margin="0 10 0 10"/>
                <Image Grid.Column="1"/>
                <Button Grid.Column="2"
                        Content="next"
                        Margin="0 10 0 10"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
