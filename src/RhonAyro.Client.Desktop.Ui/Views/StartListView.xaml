<UserControl x:Class="RhonAyro.Client.Desktop.Ui.Views.StartListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RhonAyro.Client.Desktop.Ui.Views"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="13*"/>
        </Grid.RowDefinitions>

        <!-- Discipline filter -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="10*"/>
            </Grid.ColumnDefinitions>

            <Label Content="Discipline filter"
                   VerticalContentAlignment="Center"
                   HorizontalContentAlignment="Center"
                   FontSize="16"/>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="5">
                <RadioButton Content="All"
                             Margin="0 0 25 0"/>
                <RadioButton Content="Straight basic"
                             Margin="0 0 25 0"/>
                <RadioButton Content="Straight advanced"
                             Margin="0 0 25 0"/>
                <RadioButton Content="Jump"
                             Margin="0 0 25 0"/>
                <RadioButton Content="Spiral"
                             Margin="0 0 25 0"/>
                <RadioButton Content="Pair"
                             Margin="0 0 25 0"/>
            </StackPanel>
        </Grid>

        <!-- Main -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="10*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Create roster -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Competitors -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="7*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Label Content="Selected competitor:"
                               HorizontalContentAlignment="Center"
                               VerticalContentAlignment="Center"/>
                        <Label Content="{Binding SelectedAthleteName}"
                               HorizontalContentAlignment="Center"
                               VerticalContentAlignment="Center"
                               FontWeight="Bold"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Athletes}"
                              SelectedItem="{Binding SelectedAthlete, Mode=OneWayToSource}"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <!-- Full name -->
                            <DataGridTextColumn
                                Binding="{Binding FullName, Mode=OneWay}"
                                IsReadOnly="True">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="Athlete"/>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="5 0 5 0"/>
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Id -->
                            <DataGridTextColumn
                                Binding="{Binding Id, Mode=OneWay}"
                                IsReadOnly="True">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="ID"/>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="5 0 5 0"/>
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="FontSize" Value="11"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
                <!-- Coaches -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="7*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Label Content="Selected coach:"
                               HorizontalContentAlignment="Center"
                               VerticalContentAlignment="Center"/>
                        <Label Content="{Binding SelectedCoachName}"
                               HorizontalContentAlignment="Center"
                               VerticalContentAlignment="Center"
                               FontWeight="Bold"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Coaches}"
                              SelectedItem="{Binding SelectedCoach}"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <!-- Full name -->
                            <DataGridTextColumn
                                Binding="{Binding FullName, Mode=OneWay}"
                                IsReadOnly="True">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="Coach"/>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="5 0 5 0"/>
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Id -->
                            <DataGridTextColumn
                                Binding="{Binding Id, Mode=OneWay}"
                                IsReadOnly="True">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="ID"/>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="5 0 5 0"/>
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="FontSize" Value="11"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
                <!-- Wheel size -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/> <!-- Top label -->
                        <RowDefinition Height="auto"/> <!-- Wheel size -->
                        <RowDefinition Height="15"/> <!-- Gap -->
                        <RowDefinition Height="30"/> <!-- Discipline label -->
                        <RowDefinition Height="5*"/> <!-- Disciplines -->
                        <RowDefinition Height="15"/> <!-- Gap -->
                        <RowDefinition Height="30"/> <!-- Start no label -->
                        <RowDefinition Height="auto"/> <!-- Start no -->
                        <RowDefinition Height="*"/> <!-- Button up -->
                        <RowDefinition Height="*"/> <!-- Button down -->
                    </Grid.RowDefinitions>
                    <Label Content="Specify wheel size"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center"
                           FontWeight="Bold"/>
                    <TextBox Grid.Row="1"
                             Text="210"
                             Height="60"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"
                             FontSize="25"
                             FontWeight="Bold"/>
                    <Label Grid.Row="3"
                           Content="Choose disciplines"
                           VerticalContentAlignment="Center"
                           HorizontalContentAlignment="Center"
                           FontWeight="Bold"/>
                    <StackPanel Grid.Row="4"
                                Orientation="Vertical"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Margin="5">
                        <StackPanel.Resources>
                            <Style TargetType="CheckBox">
                                <Setter Property="Margin" Value="0 0 0 5"/>
                            </Style>
                        </StackPanel.Resources>
                        <CheckBox Content="Straight basic"/>
                        <CheckBox Content="Straight advanced"/>
                        <CheckBox Content="Jump"/>
                        <CheckBox Content="Spiral"/>
                        <CheckBox Content="Pair"/>
                    </StackPanel>
                    <Label Grid.Row="6"
                           Content="Start number"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center"
                           FontWeight="Bold"/>
                    <Label Grid.Row="7"
                           Content="3"
                           Height="60"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center"
                           FontSize="25"
                           FontWeight="Bold"/>
                    <Button Grid.Row="8"
                            Content="Up"
                            Margin="10 2 10 2"/>
                    <Button Grid.Row="9"
                            Content="Down"
                            Margin="10 2 10 2"/>
                </Grid>
            </Grid>

            <!-- Start list-->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="7*"/>
                </Grid.RowDefinitions>
                <Label Content="Roster"
                       HorizontalContentAlignment="Center"
                       VerticalContentAlignment="Center"
                       FontWeight="Bold"/>
                <DataGrid Grid.Row="1"/>
            </Grid>

            <Button Grid.Row="3"
                    Margin="10"
                    Content="Add to start list"/>

            <Button Grid.Row="3" Grid.Column="1"
                    Margin="10"
                    Content="Remove from start list"/>
        </Grid>
    </Grid>
</UserControl>
