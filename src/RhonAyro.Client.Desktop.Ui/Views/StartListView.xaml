<UserControl x:Class="RhonAyro.Client.Desktop.Ui.Views.StartListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RhonAyro.Client.Desktop.Ui.Views"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="9*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Choose discipline -->
        <Grid Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="10*"/>
            </Grid.ColumnDefinitions>

            <Label Content="Choose discipline"
                   VerticalContentAlignment="Center"
                   HorizontalContentAlignment="Center"
                   FontSize="16"/>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="5">
                <RadioButton Content="Straight basic"
                             Margin="0 0 25 0"/>
                <RadioButton Content="Straight advanced"
                             Margin="0 0 25 0"/>
                <RadioButton Content="Jump"
                             Margin="0 0 25 0"/>
                <RadioButton Content="Spiral"
                             Margin="0 0 25 0"/>
                <RadioButton Content="Pair"
                             Margin="0 0 25 0"/>
            </StackPanel>
        </Grid>
        
        <!-- Create roster -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Create roster -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="7*"/>
                </Grid.RowDefinitions>
                <Label Content="Select competitor"
                       HorizontalContentAlignment="Center"
                       VerticalContentAlignment="Center"
                       FontWeight="Bold"/>
                <DataGrid Grid.Row="1"/>
            </Grid>
            <!-- Create roster -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="60"/>
                </Grid.RowDefinitions>
                <Label Content="Specify wheel size"
                       HorizontalContentAlignment="Center"
                       VerticalContentAlignment="Center"
                       FontWeight="Bold"/>
                <TextBox Grid.Row="1"
                         Text="Hello"
                         HorizontalContentAlignment="Center"
                         VerticalContentAlignment="Center"
                         FontSize="25"
                         FontWeight="Bold"/>
            </Grid>
            <!-- Create roster -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="7*"/>
                </Grid.RowDefinitions>
                <Label Content="Select coach"
                       HorizontalContentAlignment="Center"
                       VerticalContentAlignment="Center"
                       FontWeight="Bold"/>
                <DataGrid Grid.Row="1"/>
            </Grid>
        </Grid>
        
        <!-- Start list-->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="7*"/>
            </Grid.RowDefinitions>
            <Label Content="Roster"
                       HorizontalContentAlignment="Center"
                       VerticalContentAlignment="Center"
                       FontWeight="Bold"/>
            <DataGrid Grid.Row="1"/>
        </Grid>

        <Label Grid.Row="1" Grid.Column="1"
               Content=""/>

        <Button Grid.Row="3"
                Margin="10"
                Content="Add to start list"/>

        <Button Grid.Row="3" Grid.Column="1"
                Margin="10"
                Content="Remove from start list"/>

    </Grid>
</UserControl>
