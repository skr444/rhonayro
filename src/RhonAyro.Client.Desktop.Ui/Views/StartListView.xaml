<UserControl x:Class="RhonAyro.Client.Desktop.Ui.Views.StartListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RhonAyro.Client.Desktop.Ui.Views"
             xmlns:behaviors="clr-namespace:RhonAyro.Client.Desktop.Ui.Behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="13*"/>
        </Grid.RowDefinitions>

        <!-- Discipline filter -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="10*"/>
            </Grid.ColumnDefinitions>

            <Label Content="Discipline filter"
                   VerticalContentAlignment="Center"
                   HorizontalContentAlignment="Center"
                   FontSize="16"/>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="5">
                <RadioButton Content="{Binding AllDisciplinesLabel}"
                             Margin="0 0 25 0"
                             IsChecked="{Binding AllDisciplinesChecked, Mode=OneWayToSource}"/>
                <RadioButton Content="{Binding StraightBasicLabel}"
                             Margin="0 0 25 0"
                             IsChecked="{Binding StraightBasicChecked, Mode=OneWayToSource}"/>
                <RadioButton Content="{Binding StraightAdvancedLabel}"
                             Margin="0 0 25 0"
                             IsChecked="{Binding StraightAdvancedChecked, Mode=OneWayToSource}"/>
                <RadioButton Content="{Binding JumpLabel}"
                             Margin="0 0 25 0"
                             IsChecked="{Binding JumpChecked, Mode=OneWayToSource}"/>
                <RadioButton Content="{Binding SpiralLabel}"
                             Margin="0 0 25 0"
                             IsChecked="{Binding SpiralChecked, Mode=OneWayToSource}"/>
                <RadioButton Content="{Binding PairLabel}"
                             Margin="0 0 25 0"
                             IsChecked="{Binding PairChecked, Mode=OneWayToSource}"/>
            </StackPanel>
        </Grid>

        <!-- Main -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="10*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Create roster -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Competitors -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="7*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Label Content="Selected competitor:"
                               HorizontalContentAlignment="Center"
                               VerticalContentAlignment="Center"/>
                        <Label Content="{Binding SelectedAthleteName}"
                               HorizontalContentAlignment="Center"
                               VerticalContentAlignment="Center"
                               FontWeight="Bold"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Athletes}"
                              SelectedItem="{Binding SelectedAthlete, Mode=OneWayToSource}"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <!-- Full name -->
                            <DataGridTextColumn
                                Binding="{Binding FullName, Mode=OneWay}"
                                IsReadOnly="True">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="Athlete"/>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="5 0 5 0"/>
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Id -->
                            <DataGridTextColumn
                                Binding="{Binding Id, Mode=OneWay}"
                                IsReadOnly="True">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="ID"/>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="5 0 5 0"/>
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="FontSize" Value="11"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
                <!-- Coaches -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="7*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Label Content="Selected coach:"
                               HorizontalContentAlignment="Center"
                               VerticalContentAlignment="Center"/>
                        <Label Content="{Binding SelectedCoachName}"
                               HorizontalContentAlignment="Center"
                               VerticalContentAlignment="Center"
                               FontWeight="Bold"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Coaches}"
                              SelectedItem="{Binding SelectedCoach}"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <!-- Full name -->
                            <DataGridTextColumn
                                Binding="{Binding FullName, Mode=OneWay}"
                                IsReadOnly="True">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="Coach"/>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="5 0 5 0"/>
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Id -->
                            <DataGridTextColumn
                                Binding="{Binding Id, Mode=OneWay}"
                                IsReadOnly="True">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="ID"/>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="5 0 5 0"/>
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="FontSize" Value="11"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
                <!-- Wheel size -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/> <!-- Top label -->
                        <RowDefinition Height="5*"/> <!-- Disciplines -->
                        <RowDefinition Height="15"/> <!-- Gap -->
                        <RowDefinition Height="30"/> <!-- Start no label -->
                        <RowDefinition Height="auto"/> <!-- Start no -->
                        <RowDefinition Height="*"/> <!-- Button up -->
                        <RowDefinition Height="*"/> <!-- Button down -->
                    </Grid.RowDefinitions>
                    <Label Content="Disciplines and wheel sizes"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center"
                           FontWeight="Bold"/>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding DisciplinesAndWheelSizes}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="All">
                        <DataGrid.Columns>
                            <!-- Column 1: checkbox + discipline name -->
                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="Discipline"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Margin="5"/>
                                            <TextBox Text="{Binding DisciplineName, Mode=OneWay}"
                                                     VerticalAlignment="Center"
                                                     VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Column 2: wheel size (enabled only when checked) -->
                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="Wheel size"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>

                                <!-- display mode -->
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding WheelSize, StringFormat={}{0:0.##}}"
                                                   VerticalAlignment="Center"
                                                   Margin="5 0 0 0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>

                                <!-- edit mode -->
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding WheelSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.##}}"
                                                 IsEnabled="{Binding IsSelected}"
                                                 behaviors:TextBoxBehaviors.DigitsOnly="True"
                                                 VerticalAlignment="Center"
                                                 VerticalContentAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Label Grid.Row="3"
                           Content="Start number"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center"
                           FontWeight="Bold"/>
                    <Label Grid.Row="4"
                           Content="3"
                           Height="60"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center"
                           FontSize="25"
                           FontWeight="Bold"/>
                    <Button Grid.Row="5"
                            Content="Up"
                            Margin="10 2 10 2"/>
                    <Button Grid.Row="6"
                            Content="Down"
                            Margin="10 2 10 2"/>
                </Grid>
            </Grid>

            <!-- Start list-->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="7*"/>
                </Grid.RowDefinitions>
                <Label Content="Roster"
                       HorizontalContentAlignment="Center"
                       VerticalContentAlignment="Center"
                       FontWeight="Bold"/>
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Roster}"
                          SelectedItem="{Binding SelectedStartListEntryItem}"
                          IsReadOnly="True"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False">
                    <DataGrid.Columns>
                        <!-- Athlete name -->
                        <DataGridTextColumn
                            Binding="{Binding Athlete, Mode=OneWay}"
                            IsReadOnly="True">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="Athlete"/>
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="5 0 5 0"/>
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        
                        <!-- Discipline -->
                        <DataGridTextColumn
                            Binding="{Binding Discipline, Mode=OneWay}"
                            IsReadOnly="True">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="Discipline"/>
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="5 0 5 0"/>
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Wheel -->
                        <DataGridTextColumn
                            Binding="{Binding WheelSize, Mode=OneWay}"
                            IsReadOnly="True">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="Wheel"/>
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="5 0 5 0"/>
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Coach name -->
                        <DataGridTextColumn
                            Binding="{Binding Coach, Mode=OneWay}"
                            IsReadOnly="True">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="Coach"/>
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="5 0 5 0"/>
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Button Grid.Row="3"
                    Margin="10"
                    Content="Add to start list"
                    Command="{Binding AddToRosterCommand}"/>

            <Button Grid.Row="3" Grid.Column="1"
                    Margin="10"
                    Content="Remove from start list"
                    Command="{Binding RemoveFromRosterCommand}"/>
        </Grid>
    </Grid>
</UserControl>
